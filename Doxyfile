# Doxygen configuration for Coffee and Wifi.
# Generate the documentation with:  doxygen Doxyfile
# Output goes to docs/doxygen/ (ignored by git).

PROJECT_NAME           = "Coffee and Wifi"
PROJECT_BRIEF          = "Day 62 of 100 Days of Code: a Flask site that lists London cafes"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = src
FILE_PATTERNS          = *.py
RECURSIVE              = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
